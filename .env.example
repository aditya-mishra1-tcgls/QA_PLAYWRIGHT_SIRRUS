TEST_ENV=qa
# Local dashboard binding. Use 0.0.0.0 only on a server behind your firewall/proxy.
# QA_DASHBOARD_HOST=127.0.0.1
# QA_DASHBOARD_PORT=9324
# Protect the dashboard page, APIs, reports, screenshots, and event stream with browser login.
# These values bootstrap the first dashboard admin when config/dashboard-users.local.json does not exist.
# QA_DASHBOARD_AUTH_USERNAME=admin
# QA_DASHBOARD_AUTH_PASSWORD=change-this-password
# Set this when the dashboard is deployed under a path prefix such as https://host/qa-playwrite/.
# QA_DASHBOARD_BASE_PATH=/qa-playwrite
#
# Permanent test-run metadata. PostgreSQL is recommended (Neon, RDS, Supabase, etc.).
# QA_DATABASE_URL=postgresql://user:password@host:5432/qa_automation?sslmode=require
# QA_DATABASE_SSL=true
# QA_DATABASE_CONNECTION_TIMEOUT_MS=10000
#
# Permanent artifacts. Any S3-compatible provider works (AWS S3, Cloudflare R2, MinIO).
# QA_S3_BUCKET=qa-playwright-artifacts
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# QA_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# QA_S3_FORCE_PATH_STYLE=false
# QA_S3_PREFIX=lower-automation
# QA_S3_PUBLIC_BASE_URL=https://<public-artifact-domain>/<optional-prefix>
